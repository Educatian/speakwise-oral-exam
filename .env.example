# Browser-visible data bridge configuration for the deployed demo.
VITE_SUPABASE_URL=https://speakwise-data.jewoong-moon.workers.dev
VITE_SUPABASE_ANON_KEY=cloudflare-migrated

# Server only: set these in Cloudflare Pages bindings, or in .dev.vars
# for local development with wrangler pages dev dist. Use your deployment names.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<server secret>
# AZURE_OPENAI_CHAT_DEPLOYMENT=<chat deployment supporting JSON output>
# Set the Speech endpoint to use Foundry Speech with the same resource key.
# AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# Alternatively, omit AZURE_SPEECH_ENDPOINT and configure both audio deployments:
# AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=<speech-to-text deployment>
# AZURE_OPENAI_SPEECH_DEPLOYMENT=<text-to-speech deployment supporting PCM>
# AZURE_OPENAI_VOICE=alloy
# Optional for reasoning models: AZURE_OPENAI_REASONING_EFFORT=none
# Optional second chat deployment on the same resource for capacity errors:
# AZURE_OPENAI_FALLBACK_CHAT_DEPLOYMENT=<second chat deployment>
# AZURE_OPENAI_FALLBACK_REASONING_EFFORT=low
