{
  "name": "speakwise-ai-platform",
  "private": true,
  "version": "2.2.0",
  "description": "Institution-ready AI oral assessment platform with transcript review, concept maps, instructor override, and course deployment workflows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"tests/**/*.ts\" vitest.config.ts eslint.config.js CHANGELOG.md",
    "format:check": "prettier --check \"tests/**/*.ts\" vitest.config.ts eslint.config.js CHANGELOG.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node playwright/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@supabase/supabase-js": "^2.93.2",
    "d3": "^7.9.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "marked": "^18.0.2",
    "prettier": "^3.8.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  }
}
