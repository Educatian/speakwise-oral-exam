{
  "name": "speakwise-ai-platform",
  "private": true,
  "version": "2.1.9",
  "description": "Institution-ready AI oral assessment platform with transcript review, concept maps, instructor override, and course deployment workflows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "test:voice": "vitest run tests/voice-recovery.test.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@google/genai": "^1.38.0",
    "@stylexjs/stylex": "^0.19.2",
    "@supabase/supabase-js": "^2.93.2",
    "d3": "^7.9.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^18.0.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "4.1.8"
  }
}
